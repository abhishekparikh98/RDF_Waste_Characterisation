import datetime
from tabulate import tabulate

def calculate_overallscore(c1, c2, c3, finalexam):
    overall = round(c1 * 0.10 + c2 * 0.20 + c3 * 0.30 + finalexam * 0.40)
    return overall

def determine_category(score):
    # ----- Adjust score -----
    if 93 <= score <= 99:   score = 100
    elif 79 <= score <= 81: score = 82
    elif 69 <= score <= 71: score = 72
    elif 61 <= score <= 67: score = 68
    elif 59 <= score <= 61: score = 62
    elif 49 <= score <= 51: score = 52
    elif 39 <= score <= 41: score = 42
    elif 21 <= score <= 31: score = 25

    # ----- Get category -----
    if score == 100:              return score, "- Aurum Standard"
    elif 82 <= score <= 92:       return score, "- Upper First"
    elif 72 <= score <= 78:       return score, "- First"
    elif 62 <= score <= 68:       return score, "- 2:1"
    elif 52 <= score <= 58:       return score, "- 2:2"
    elif 42 <= score <= 48:       return score, "- Third"
    elif 32 <= score <= 38:       return score, "- Condonable Fail"
    elif 5 <= score <= 25:        return score, "- Fail"
    elif score == 0:              return score, "- Defecit Opus"
    else:                         return score, "- Invalid overallscore"

def main():
    students = []
    while len(students) < 3:
        student_id = input("Enter student ID (or 'end' to stop): ")
        if student_id.lower() == "end":
            break
        
        name = input("Enter name: ")
        dob_input = input("Enter DOB (YYYY-MM-DD): ")
        try:
            dob = datetime.strptime(dob_input, "%Y-%m-%d")
        except:
            print("Invalid date!")
            continue
        
        c1 = float(input("Coursework 1: "))
        c2 = float(input("Coursework 2: "))
        c3 = float(input("Coursework 3: "))
        final = float(input("Final exam: "))
        
        overall = calculate_overallscore(c1, c2, c3, final)
        final_score, category = determine_category(overall)
        
        students.append([student_id, name, dob.strftime("%Y-%m-%d"), final_score, category])
    
    # Print nice table
    print(tabulate(students, headers=["ID", "Name", "DOB", "Score", "Classification"], tablefmt="grid"))

# Run the program
main()