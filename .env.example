# Configuration file for project settings
# This file will be loaded using python-dotenv

# Dataset paths
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed

# Model paths
MODEL_SAVE_PATH=./models
CHECKPOINT_PATH=./models/checkpoints

# Experiment tracking
WANDB_PROJECT=msc-waste-characterisation
WANDB_ENTITY=

# Random seed for reproducibility
RANDOM_SEED=42

# Logging
LOG_LEVEL=INFO

# Flask
# Secret key for Flask session signing. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=change-me

# Where to fetch missing model weights on first run. Defaults to the
# GitHub Release tagged v1.0-models on this repo. Set to empty to disable
# auto-download (then you must supply the weights yourself).
RDF_WEIGHTS_RELEASE_TAG=v1.0-models
